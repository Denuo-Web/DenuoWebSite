# GitHub Actions / deployment secrets (set in repository secrets, not committed)
FIREBASE_SERVICE_ACCOUNT="{\"type\":\"service_account\",...}"
FIREBASE_PROJECT_ID=your-firebase-project-id
GCP_SERVICE_ACCOUNT_KEY="{\"type\":\"service_account\",...}"
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
STRIPE_SECRET_KEY=sk_live_or_test_key_here
CONTACT_REQUIRE_APP_CHECK=true
CONTACT_REQUIRE_CAPTCHA=true
TURNSTILE_SECRET_KEY=turnstile_secret_here
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CONTACT_IP_HASH_SALT=replace-with-long-random-value
